# Só segredos ficam aqui; o restante da configuração está em config.yaml.
# Opcional: caminho de outro arquivo de configuração
# BOOP_CONFIG=./config.yaml
# Opcional: sobrescreve o target do YAML (firestore | mongodb | memory)
# BOOP_TARGET=mongodb

# Firestore: caminho da service account (nome definido em databases.firestore.credentials_env)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json

# MongoDB: connection string (nome definido em databases.mongodb.uri_env)
BOOP_MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/?retryWrites=true&w=majority

# SQLite (opcional): sobrescreve databases.sqlite.path
# BOOP_SQLITE_PATH=./data/booprecognition.db
